# Startup settings for the Saturn home (~/.saturn, or SATURN_HOME).
# scripts/setup.py creates only a missing home .env. It never reads or replaces a checkout .env.
# Model and output settings belong in settings.toml. Command rules belong in policy.toml.

LOCAL_SERVER_API_KEY= # Optional key from your local model server; leave empty for servers without authentication.
SATURN_HOST=127.0.0.1 # Loopback interface from your local network configuration. Remote listening is refused.
SATURN_PORT=9000 # Unused local TCP port. Change it when another application uses 9000.
SATURN_DATA_DIR= # Optional absolute store path. Empty uses data/ in the Saturn home.
SATURN_SHUTDOWN_GRACE_S=5 # Seconds to finish requests at shutdown; choose 0 through 600.
SATURN_LLM_TIMEOUT_S=180 # Seconds allowed for one model call; choose greater than 0, up to 3600.
SATURN_LLM_CONCURRENCY=1 # Concurrent model calls; choose 1 through 8 for your hardware.
SATURN_INTERNAL_TIMING=false # Optional bounded internal timing. Enable only in an isolated measurement home.
